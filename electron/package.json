{
  "name": "denia",
  "private": true,
  "version": "0.9.1",
  "description": "Denia desktop host: TypeScript agent runtime with the shared web console",
  "author": "Denia",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test",
    "start": "node scripts/build.mjs && electron .",
    "dev": "node scripts/dev.mjs",
    "dist": "node scripts/fetch-cloudflared.mjs && node scripts/build.mjs && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  },
  "build": {
    "appId": "dev.denia.app",
    "productName": "Denia",
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "copyright": "Denia",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "builtin-skills/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@lydell/node-pty*/**/*"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/cloudflared",
        "to": "cloudflared",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "executableName": "Denia",
      "signExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "include": "build/installer.nsh",
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Denia",
      "runAfterFinish": true,
      "artifactName": "Denia-v${version}-windows-x64-setup.${ext}",
      "allowToChangeInstallationDirectory": false
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@lydell/node-pty": "^1.1.0",
    "@zhizhuodemao/patchright": "^1.61.1-mcp.2",
    "openai": "^7.53.0",
    "ws": "^8.23.0",
    "yaml": "^2.9.1"
  }
}
