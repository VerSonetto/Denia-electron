{
  "name": "denia",
  "private": true,
  "version": "0.6.1",
  "description": "Denia desktop host: TypeScript agent runtime with the shared web console",
  "author": "Denia",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/loop.test.ts test/cancel.test.ts test/open-in-app.test.ts test/adapters.test.ts test/shared-home.test.ts test/permission.test.ts test/approval.test.ts test/mcp.test.ts test/subagent.test.ts test/context.test.ts test/context-usage.test.ts test/session.test.ts test/rewind.test.ts test/jobs.test.ts test/skill-invocation.test.ts test/completion-delivery.test.ts",
    "start": "node scripts/build.mjs && electron .",
    "dev": "node scripts/dev.mjs",
    "dist": "node scripts/build.mjs && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  },
  "build": {
    "appId": "dev.denia.app",
    "productName": "Denia",
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "copyright": "Denia",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "builtin-skills/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "executableName": "Denia",
      "signExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "include": "build/installer.nsh",
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Denia",
      "runAfterFinish": false,
      "artifactName": "Denia-v${version}-windows-x64-setup.${ext}"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "openai": "^7.53.0",
    "yaml": "^2.9.1"
  }
}
